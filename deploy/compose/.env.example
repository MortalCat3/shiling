# 复制为同目录 .env。这里没有可用凭据；先运行 create-secrets.mjs。
COMPOSE_PROJECT_NAME=shiling
SHILING_RELEASE=local
SHILING_POSTGRES_IMAGE=postgres:18.7-bookworm
SHILING_NODE_IMAGE=node:24.22.3-bookworm-slim
SHILING_CADDY_IMAGE=caddy:2.11.9-alpine

# 本地验证仅监听回环地址。对外部署见 README，必须同时配置 HTTPS 与来源。
SHILING_BIND_ADDRESS=127.0.0.1
SHILING_HTTP_PORT=8080
SHILING_HTTPS_PORT=8443
SHILING_SITE_ADDRESS=http://localhost
SHILING_APP_ORIGIN=http://localhost:8080
SHILING_PUBLIC_ORIGIN=http://localhost:8080
SHILING_PREVIEW_ORIGIN=http://preview.localhost:8080
SHILING_COOKIE_SECURE=false
SHILING_SESSION_TTL_HOURS=24
SHILING_UPLOAD_MAX_BYTES=104857600
SHILING_TEMP_OBJECT_RETENTION_HOURS=24
SHILING_CLEANUP_INTERVAL_SECONDS=900
SHILING_CLEANUP_BATCH_SIZE=25
SHILING_VERIFY_CONCURRENCY=2
SHILING_PROCESS_CONCURRENCY=2
SHILING_LOG_LEVEL=info

# 相对于本 Compose 文件；每个文件仅含一个值，禁止提交。
SHILING_POSTGRES_PASSWORD_FILE=./secrets.local/postgres-password
SHILING_APP_PASSWORD_FILE=./secrets.local/app-password
SHILING_MIGRATION_PASSWORD_FILE=./secrets.local/migration-password
SHILING_DATABASE_URL_FILE=./secrets.local/database-url
SHILING_MIGRATION_DATABASE_URL_FILE=./secrets.local/migration-database-url
SHILING_SETUP_TOKEN_FILE=./secrets.local/setup-token
SHILING_CSRF_SECRET_FILE=./secrets.local/csrf-secret
SHILING_DELIVERY_SECRET_FILE=./secrets.local/delivery-secret

# 复用同机已有 PostgreSQL 容器时，叠加 compose.postgres-external.yaml。
# 填实际存在且数据库已加入的用户自定义 Docker 网络；数据库连接仍来自上面的 URL 文件。
# SHILING_DATABASE_NETWORK=database_private

# 可选：同时使用 compose.oss.yaml；保留本配置文件中的凭据路径为宿主路径。
# SHILING_OSS_REGION=oss-cn-hangzhou
# SHILING_OSS_BUCKET=example-shiling
# SHILING_OSS_PREFIX=team-one/primary/
# SHILING_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# SHILING_OSS_CREDENTIALS_FILE=./secrets.local/oss-credentials.json
# SHILING_OSS_MAX_OBJECT_BYTES=104857600
# OSS 首轮验收建议 SHILING_VERIFY_CONCURRENCY=1、SHILING_PROCESS_CONCURRENCY=1。
