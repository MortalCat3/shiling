# 首期业务服务的本地配置示例。
# 仅作本地开发示例；复制到 .env 后替换占位值，不提交运行配置。
# 运行、迁移、测试使用不同角色；数据库必须是拾灵专用库。
SHILING_DATABASE_URL=postgresql://shiling_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/shiling_dev
SHILING_MIGRATION_DATABASE_URL=postgresql://shiling_migrate:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/shiling_dev
SHILING_DATABASE_OWNER_ROLE=shiling_owner
SHILING_DATABASE_RUNTIME_ROLE=shiling_app
SHILING_TEST_DATABASE_URL=postgresql://shiling_test:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/shiling_test

SHILING_API_HOST=127.0.0.1
SHILING_API_PORT=3000
SHILING_PREVIEW_HOST=127.0.0.1
SHILING_PREVIEW_PORT=3001
SHILING_LOG_LEVEL=info
SHILING_STORAGE_DRIVER=local
SHILING_LOCAL_STORAGE_ROOT=./data/objects
SHILING_APP_ORIGIN=http://127.0.0.1:5173
SHILING_PUBLIC_ORIGIN=http://127.0.0.1:5173
# 必须与主站使用不同主机名；只换端口不能隔离 cookie。
SHILING_PREVIEW_ORIGIN=http://preview.localhost:3001
SHILING_COOKIE_SECURE=false
# 直连开发默认不信任转发头；只在反代部署时填写受控代理的主机名/IP。
SHILING_TRUSTED_PROXY_HOST=
SHILING_PREVIEW_EXECUTION_ENABLED=false

# 以下是开发预算，不代表生产容量或签名授权窗口已经确认。
SHILING_SESSION_TTL_HOURS=24
SHILING_UPLOAD_MAX_BYTES=104857600
SHILING_TEMP_OBJECT_RETENTION_HOURS=24
SHILING_CLEANUP_INTERVAL_SECONDS=900
SHILING_CLEANUP_BATCH_SIZE=25
SHILING_SETUP_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SHILING_CSRF_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SHILING_DELIVERY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SHILING_DELIVERY_GRANT_TTL_SECONDS=120
